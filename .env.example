# Required: set to 64 hex characters generated from 32 random bytes, for example:
# export EHR_MASTER_KEY="$(openssl rand -hex 32)"
# Never commit the generated value. There is no fallback key.
EHR_MASTER_KEY=
# Opt in to simulated role headers only for a loopback educational demo.
EHR_ENABLE_DEMO_AUTH=false
# Optional. If set, encrypted blobs persist after exit; the local Hardhat chain still resets on restart.
# EHR_STORE_DIR=./data/encrypted-records
HOST=127.0.0.1
PORT=3000
