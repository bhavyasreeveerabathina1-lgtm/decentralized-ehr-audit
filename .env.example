# Supply a unique, random 32+ byte secret in any non-demo deployment.
# The local default is deliberately insecure and for disposable synthetic demos only.
EHR_MASTER_KEY=replace-with-random-development-key
# Optional. If set, encrypted blobs persist after exit; local Ganache still resets on restart.
# EHR_STORE_DIR=./data/encrypted-records
HOST=127.0.0.1
PORT=3000
